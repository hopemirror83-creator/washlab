---
import VertexSampleDetail from '../../components/VertexSampleDetail.astro';
import { carwashes } from '../../data/siteData';

const carwash = carwashes.find((item) => item.name === '디테일링 창과방패');
if (!carwash) throw new Error('디테일링 창과방패 데이터를 찾을 수 없습니다.');

const sample = {
  title: '인천 서해구 디테일링 창과방패 손세차와 실내스팀세차 후기 정리',
  keyword: '인천 서해구 손세차, 인천 서구 손세차, 석남동 디테일링세차, 실내스팀세차 후기',
  serviceType: '손세차·디테일링',
  lead:
    '디테일링 창과방패는 빠르게 직접 닦는 셀프세차장보다는 차량을 맡겨 관리받는 쪽에 가까운 업체로 보입니다. 손세차, 실내스팀세차, 디테일링 작업을 찾는 분들이 보기 좋도록 네이버 블로그 후기를 모아 자연스럽게 정리했습니다.',
  basic: [
    '디테일링 창과방패는 인천 서해구 석남동, 건지로 163 상가 1층에 있는 세차 업체로 확인됩니다.',
    '검색 결과에서는 디테일링세차, 실내스팀세차, 특수세차와 관련된 후기가 함께 보입니다. 차량을 잠깐 세차기에 넣고 끝내는 곳이라기보다는, 오염 상태를 보고 필요한 작업을 상담한 뒤 맡기는 형태에 더 가깝습니다.',
    '이런 업체는 “세차 가능 여부”보다 “어디까지 포함되는지”가 더 중요합니다. 실내만 맡길지, 외부 손세차까지 포함할지, 묵은 때나 냄새 관리가 필요한지에 따라 가격과 작업 시간이 달라질 수 있습니다.',
  ],
  reviewStory: [
    '네이버 블로그에서는 디테일링 창과방패 관련 글 8건을 확인했습니다.',
    '후기 제목에는 인천 서해구와 기존 인천 서구 특수세차 전문점, 디테일링세차, 실내스팀세차, 묵은 때, 새 차처럼 변했다는 식의 표현이 보입니다. 워시랩에서는 이런 표현을 그대로 광고 문구처럼 쓰기보다는, 어떤 작업을 기대할 수 있는지 살펴보는 참고 자료로 정리했습니다.',
    '후기 흐름을 보면 차량 내부 관리와 꼼꼼한 세차를 언급한 글이 많습니다. 실내스팀세차나 디테일링은 일반 자동세차처럼 짧게 끝나는 서비스가 아니어서, 차량 상태를 먼저 보고 작업 범위를 정하는 과정이 중요합니다.',
    '일부 글에서는 실내 오염 관리, 묵은 때 제거, 작업 후 차량 분위기 변화에 만족했다는 의견이 보입니다. 다만 디테일링 작업은 차종, 오염 정도, 원하는 작업 범위에 따라 결과와 비용이 달라질 수 있습니다.',
    '이 내용은 네이버 블로그의 후기를 모은 분석으로 실제 상황은 달라졌을 수 있으니 방문 전에 업체 쪽에 확인해 보시는 것도 좋을 것 같습니다. 예약 가능 시간, 예상 작업 시간, 실내세차 포함 범위는 특히 먼저 물어보는 편이 좋습니다.',
  ],
  positivePoints: [
    '디테일링세차와 실내스팀세차 관련 블로그 글이 여러 건 확인됩니다.',
    '묵은 때, 실내 오염, 차량 분위기 변화 등을 언급한 후기가 있습니다.',
    '차량을 맡겨 관리받는 세차를 찾는 분에게 비교 후보가 될 수 있습니다.',
    '석남동과 인천 서해구 주변에서 손세차나 실내세차를 찾을 때 함께 검토하기 좋습니다.',
  ],
  checkPoints: [
    '가격은 차량 크기와 오염 정도, 선택 작업에 따라 달라질 수 있어 예약 전 문의가 필요합니다.',
    '실내스팀세차, 외부 손세차, 광택·코팅 상담이 각각 포함되는지 확인해 주세요.',
    '작업 시간이 길어질 수 있으니 당일 방문보다 예약 가능 시간을 먼저 보는 편이 좋습니다.',
    '반려동물 털, 음식물 오염, 오래된 냄새처럼 추가 작업이 필요한 경우 별도 비용이 있을 수 있습니다.',
  ],
  answerCards: [
    { label: '손세차', value: '가능성 높음', note: '검색 결과와 후기 제목에서 손세차·디테일링 성격이 강하게 보입니다.' },
    { label: '실내스팀세차', value: '언급 있음', note: '네이버 블로그 후기 제목에서 실내스팀세차 관련 표현이 확인됩니다.' },
    { label: '예약', value: '확인 필요', note: '디테일링 작업은 시간이 걸릴 수 있어 사전 문의가 안전합니다.' },
    { label: '가격', value: '확인 필요', note: '차량 크기와 오염 상태, 작업 범위에 따라 달라질 수 있습니다.' },
  ],
};
---

<VertexSampleDetail carwash={carwash} sample={sample} />
