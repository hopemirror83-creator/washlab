---
import VertexSampleDetail from '../../components/VertexSampleDetail.astro';
import { carwashes } from '../../data/siteData';

const carwash = carwashes.find((item) => item.name === '킹콩샤워 검단점');
if (!carwash) throw new Error('킹콩샤워 검단점 데이터를 찾을 수 없습니다.');

const sample = {
  title: '인천 검단구 킹콩샤워 검단점 셀프세차장 후기와 방문 전 확인사항',
  keyword: '인천 검단구 셀프세차장, 검단 세차장, 인천 서구 세차장, 킹콩샤워 검단점 후기',
  serviceType: '셀프세차장',
  lead:
    '검단에서 직접 세차할 곳을 찾는다면 킹콩샤워 검단점은 한 번쯤 비교하게 되는 곳입니다. 네이버 블로그 후기를 모아보면 공간, 장비, 대기 시간에 대한 이야기가 꽤 보입니다. 워시랩에서는 이 내용을 직접 다녀온 후기처럼 쓰지 않고, 방문 전에 참고하기 좋은 분위기로 정리했습니다.',
  basic: [
    '킹콩샤워 검단점은 인천 검단구 왕길동, 원당대로 531 1층에 있는 셀프세차장으로 확인됩니다.',
    '검단 신도시, 원당동, 왕길동 주변에서 셀프세차장을 찾는 분들이 함께 비교해볼 만한 위치입니다. 직접 고압수와 거품, 드라잉 공간을 이용하는 방식이라 세차 베이와 동선, 장비 상태가 실제 만족도에 영향을 많이 줍니다.',
    '네이버 검색에서는 검단 셀프세차장, 24시간 셀프세차장, 킹콩게러지 같은 표현이 함께 보입니다. 다만 운영시간과 세부 시설은 바뀔 수 있으니 방문 직전에는 네이버 지도나 업체 안내를 한 번 더 보는 편이 좋습니다.',
  ],
  reviewStory: [
    '네이버 블로그에서는 킹콩샤워 검단점 관련 글 8건을 확인했습니다.',
    '후기 제목과 내용을 보면 “검단 셀프세차장”, “가성비”, “쾌적한 세차장” 같은 표현이 반복됩니다. 공간이 넓어 보이고 장비 배치가 비교적 편해 보인다는 의견이 있으며, 사진이 포함된 글에서는 베이와 드라잉 공간 분위기를 미리 살펴볼 수 있습니다.',
    '셀프세차장은 막상 가보면 작은 차이가 크게 느껴집니다. 세차 베이가 좁으면 옆 차량이 신경 쓰이고, 드라잉 자리가 부족하면 물기 닦는 시간이 쫓기듯 흘러갑니다. 킹콩샤워 검단점 후기는 이런 공간감에 대한 이야기가 꽤 보여서, 처음 방문하는 분에게 참고가 됩니다.',
    '일부 글에서는 킹콩게러지나 실내 관리 공간처럼 보이는 별도 공간도 언급됩니다. 이런 공간은 기본 시설인지, 예약이 필요한 공간인지, 별도 요금이 있는지 시점에 따라 달라질 수 있습니다.',
    '이 내용은 네이버 블로그의 후기를 모은 분석으로 실제 상황은 달라졌을 수 있으니, 방문 전에 업체 쪽에 확인해 보시는 것도 좋을 것 같습니다. 특히 주말이나 저녁 시간대에는 사람이 몰릴 수 있어 여유 있는 시간에 가는 편이 더 편할 수 있습니다.',
  ],
  positivePoints: [
    '검단 셀프세차장으로 언급하는 블로그 글이 여러 건 확인됩니다.',
    '공간이 넓고 쾌적해 보인다는 의견이 있습니다.',
    '사진이 있는 후기에서 세차 베이와 드라잉 공간 분위기를 미리 볼 수 있습니다.',
    '검단, 왕길동, 원당동 주변에서 직접 세차할 곳을 찾는 분에게 비교 후보가 될 만합니다.',
  ],
  checkPoints: [
    '운영시간과 요금은 방문 전에 네이버 지도나 업체 안내로 확인해 주세요.',
    '하부세차, 진공청소기, 매트세척기, 카드결제 가능 여부는 현장 기준으로 달라질 수 있습니다.',
    '주말이나 저녁 시간에는 세차 베이와 드라잉 공간 대기가 생길 수 있습니다.',
    '킹콩게러지 같은 별도 공간은 이용 조건과 예약 여부를 확인하는 것이 좋습니다.',
  ],
  answerCards: [
    { label: '셀프세차', value: '있음', note: '네이버 지역검색과 블로그 후기에서 셀프세차장으로 확인됩니다.' },
    { label: '후기', value: '있음', note: '네이버 블로그 관련 글 8건을 참고했습니다.' },
    { label: '24시간 여부', value: '확인 필요', note: '후기 제목에는 24시간 표현이 보이나, 현재 운영은 업체 안내 기준으로 확인하는 편이 좋습니다.' },
    { label: '하부세차', value: '확인 필요', note: '장비 구성은 현장 상황에 따라 달라질 수 있어 방문 전 확인이 필요합니다.' },
  ],
};
---

<VertexSampleDetail carwash={carwash} sample={sample} />
