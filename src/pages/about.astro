---
import BaseLayout from '../layouts/BaseLayout.astro';
import { domainConfig } from '../data/domainConfig';

const title = `운영자 안내 | ${domainConfig.siteName}`;
const description = '워시랩 운영 목적, 데이터 출처, 운영자 정보와 세차장 정보 확인 기준을 안내합니다.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="page-head trust-page-head">
    <p class="eyebrow">운영자 안내</p>
    <h1>워시랩은 세차장 정보를 찾기 쉽게 정리하는 사이트입니다.</h1>
    <p>
      지역별 세차장, 셀프세차장, 자동세차, 손세차, 노터치세차 정보를 한곳에서 비교할 수 있도록
      지도 정보와 공개된 검색 자료를 바탕으로 정리하고 있습니다.
    </p>
  </section>

  <section class="decision-section">
    <div class="trust-grid">
      <article class="trust-card">
        <span>운영 목적</span>
        <h2>방문 전 확인할 정보를 모읍니다</h2>
        <p>
          세차장은 운영시간, 요금, 장비 상태, 제공 서비스가 자주 달라질 수 있습니다. 워시랩은 이용자가 방문 전에
          주소, 지도 위치, 세차 방식, 후기 요약을 빠르게 살펴볼 수 있도록 돕는 정보형 사이트입니다.
        </p>
      </article>
      <article class="trust-card">
        <span>데이터 출처</span>
        <h2>공개 자료와 검색 정보를 함께 참고합니다</h2>
        <p>
          네이버 지도와 네이버 검색, 네이버 블로그에 공개된 후기, 행정안전부 공공데이터 등 확인 가능한 자료를
          참고합니다. 후기는 직접 방문한 것처럼 쓰지 않고, 공개된 의견을 요약하는 방식으로 정리합니다.
        </p>
      </article>
      <article class="trust-card">
        <span>운영자 정보</span>
        <h2>스토리앤에서 운영합니다</h2>
        <dl class="trust-list">
          <div><dt>사이트명</dt><dd>{domainConfig.siteName}</dd></div>
          <div><dt>운영자명</dt><dd>스토리앤</dd></div>
          <div><dt>문의 이메일</dt><dd><a href="mailto:storyuman@gmail.com">storyuman@gmail.com</a></dd></div>
          <div><dt>사업자등록번호</dt><dd>409-58-00440</dd></div>
        </dl>
      </article>
      <article class="trust-card">
        <span>확인 안내</span>
        <h2>현장 상황은 달라질 수 있습니다</h2>
        <p>
          워시랩의 정보는 공개 자료를 바탕으로 정리하지만, 실제 현장의 운영시간, 가격, 장비 이용 가능 여부,
          예약 가능 여부는 달라질 수 있습니다. 방문 전에는 네이버 지도, 업체 공식 안내, 현장 안내를 한 번 더
          확인해 주세요.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
