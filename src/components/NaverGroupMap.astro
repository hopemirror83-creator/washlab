---
interface MapItem {
  slug: string;
  name: string;
  roadAddress?: string;
  lotAddress?: string;
  lat?: number;
  lng?: number;
  mapx?: number;
  mapy?: number;
  naverMapUrl?: string;
  washType?: string;
  areaLabel?: string;
}

interface Props {
  id: string;
  title: string;
  items: MapItem[];
  showMarkerList?: boolean;
}

const { id, title, items, showMarkerList = true } = Astro.props;
const clientId = import.meta.env.PUBLIC_NAVER_MAP_CLIENT_ID || 'w90ehbsu50';
const mapId = `naver-group-map-${id.replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 48)}`;
const markers = items
  .map((item) => {
    const latitude = Number(item.lat) || (Number(item.mapy) ? Number(item.mapy) / 10000000 : 0);
    const longitude = Number(item.lng) || (Number(item.mapx) ? Number(item.mapx) / 10000000 : 0);
    return {
      slug: item.slug,
      name: item.name,
      address: item.roadAddress || item.lotAddress || '',
      latitude,
      longitude,
      naverMapUrl:
        item.naverMapUrl ||
        `https://map.naver.com/p/search/${encodeURIComponent(`${item.name} ${item.roadAddress || item.lotAddress || ''}`)}`,
      detailUrl: `/carwash/${item.slug}/`,
      washType: item.washType || '',
      areaLabel: item.areaLabel || '',
    };
  })
  .filter((item) => item.latitude && item.longitude);

const mapPayload = JSON.stringify({
  mapId,
  clientId,
  title,
  markers,
  showMarkerList,
}).replace(/</g, '\\u003c');
---

<div class="naver-map-wrap group-map-wrap">
  <div class="naver-map group-map" id={mapId}>
    {markers.length === 0 && (
      <div class="map-fallback">
        <strong>{title}</strong>
        <span>지도 좌표가 있는 업체가 없어 목록에서 네이버 지도로 확인해 주세요.</span>
      </div>
    )}
  </div>
  <div class="map-summary">
    <strong>{title}</strong>
    <span>지도에 표시된 업체 {markers.length}곳</span>
  </div>
  {showMarkerList && (
    <div class="map-marker-list" aria-label={`${title} 지도 업체 목록`}>
      {markers.map((item, index) => (
        <a href={item.naverMapUrl} target="_blank" rel="noreferrer">
          <span>{index + 1}</span>
          <strong>{item.name}</strong>
          <small>{item.areaLabel || item.address}</small>
        </a>
      ))}
    </div>
  )}
</div>

{markers.length > 0 && (
  <script is:inline define:vars={{ mapPayload }}>
    (() => {
      const payload = JSON.parse(mapPayload);

      window.__washlabNaverMapLoader =
        window.__washlabNaverMapLoader ||
        new Promise((resolve, reject) => {
          if (window.naver?.maps) {
            resolve();
            return;
          }
          const script = document.createElement('script');
          script.src = `https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${payload.clientId}`;
          script.async = true;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });

      window.__washlabNaverMapLoader
        .then(() => {
          const target = document.getElementById(payload.mapId);
          if (!target || !window.naver?.maps) return;

          const positions = payload.markers.map((item) => new naver.maps.LatLng(item.latitude, item.longitude));
          const map = new naver.maps.Map(target, {
            center: positions[0],
            zoom: payload.markers.length > 1 ? 12 : 16,
            scaleControl: true,
            mapDataControl: false,
            zoomControl: true,
            zoomControlOptions: {
              position: naver.maps.Position.TOP_RIGHT,
            },
          });

          const bounds = new naver.maps.LatLngBounds();
          const info = new naver.maps.InfoWindow();

          payload.markers.forEach((item, index) => {
            const position = new naver.maps.LatLng(item.latitude, item.longitude);
            bounds.extend(position);
            const marker = new naver.maps.Marker({
              position,
              map,
              title: item.name,
              zIndex: 100 + index,
            });

            const showInfo = () => {
              info.setContent(`<div class="map-info-window"><strong>${item.name}</strong><span>${item.address || item.areaLabel || ''}</span><div class="map-info-actions"><a href="${item.detailUrl}">상세보기</a><a href="${item.naverMapUrl}" target="_blank" rel="noreferrer">네이버지도</a></div></div>`);
              info.open(map, marker);
            };

            naver.maps.Event.addListener(marker, 'click', showInfo);

            naver.maps.Event.addListener(marker, 'mouseover', () => {
              showInfo();
            });
          });

          if (payload.markers.length > 1) {
            map.fitBounds(bounds, { top: 42, right: 42, bottom: 42, left: 42 });
          }
        })
        .catch(() => {
          const target = document.getElementById(payload.mapId);
          if (!target) return;
          target.innerHTML = `<div class="map-fallback"><strong>${payload.title}</strong><span>지도를 불러오지 못했습니다. 아래 업체 목록에서 네이버 지도로 이동해 주세요.</span></div>`;
        });
    })();
  </script>
)}
